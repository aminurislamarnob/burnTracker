# Optional server-side accounts. When set, the keys stay on the host and the
# browser never sees them — the dashboard just lists the labels.
#
# JSON array (preferred):
CLAUDE_SESSION_KEYS='[{"label":"Personal","sessionKey":"sk-ant-sid01-..."},{"label":"Work","sessionKey":"sk-ant-sid01-..."}]'
#
# ...or a compact "label=key" list, comma or newline separated:
# CLAUDE_SESSION_KEYS="Personal=sk-ant-sid01-...,Work=sk-ant-sid01-..."

# Optional Command Code API key (the value of "apiKey" in ~/.commandcode/auth.json).
COMMAND_CODE_API_KEY=

# Optional: seconds between auto-refreshes (default 300, min 30).
REFRESH_SECONDS=300
